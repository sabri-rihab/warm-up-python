   "source": [
    "#  Écrivez du code Python ici\n",
    "n1 = int(input(\"N°1 :\"))\n",
    "n2 = int(input(\"N°2 :\"))\n",
    "\n",
    "if n1*n2 > 0:\n",
    "    print(\"produit positive\")\n",
    "elif n1*n2 < 0:\n",
    "    print(\"produit negative\")\n",
    "else:\n",
    "    print(\"produit nul\")\n"
